#!/bin/bash

if [ $# -gt 0 ]; then
    selection=$(protontricks -l | rg -i "$1" | head -n 1)
    if [ -z "$selection" ]; then
        printf "\e[1;32m\"%s\"\e[0m:\n\e[1;31m(os error 1)\e[0m No matching games found\n" "$1"
        exit 1
    fi
else
    selection=$(protontricks -l | fzf --prompt="Proton Prefixes > ")
    [ -z "$selection" ] && exit 0
fi

appid=$(echo "$selection" | sed -n 's/.*(\([0-9]\+\)).*/\1/p')
gamename=$(echo "$selection" | sed -E 's/^Non-Steam shortcut: //; s/ \([0-9]+\)$//')

printf "%s" "$appid" | wl-copy
printf "\e[1;32mSelected Game: \e[0m%s\n\n\e[1;31mPrefix ID:\e[0m %s\n" "$gamename" "$appid"
